# Upstash Redis (REST API). If you connected Upstash through Vercel's
# Marketplace integration instead of upstash.com directly, it injects these
# under Vercel's legacy "KV" names instead (KV_REST_API_URL / KV_REST_API_TOKEN)
# - the code falls back to those automatically, so either naming works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App auth
APP_PASSWORD=
SESSION_SECRET=change-me-to-a-long-random-string

# Unsubscribe link signing
UNSUBSCRIBE_SECRET=change-me-to-a-long-random-string

# Public base URL of this deployment (used to build unsubscribe links, OAuth redirect)
APP_BASE_URL=https://your-deployment.vercel.app

# Google OAuth (Gmail API) - create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client:
# {APP_BASE_URL}/api/accounts/callback
GOOGLE_REDIRECT_URI=https://your-deployment.vercel.app/api/accounts/callback

# HubSpot
HUBSPOT_API_KEY=

# Vercel Cron auth (Vercel sets this automatically as the Authorization header
# on cron invocations; set the same value here so cron endpoints can verify it)
CRON_SECRET=

# Sending limits / window
DAILY_SEND_CAP=500
SEND_WINDOW_START_HOUR=8
SEND_WINDOW_END_HOUR=18
SEND_TIMEZONE=America/New_York
